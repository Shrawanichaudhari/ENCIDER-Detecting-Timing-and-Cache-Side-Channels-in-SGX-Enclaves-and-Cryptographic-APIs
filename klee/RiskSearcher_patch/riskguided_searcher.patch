+  /// RiskSearcher implements a scoped, real (non-simulated) prototype of the
+  /// open-comparison-guided scheduler from the accompanying paper
+  /// ("Risk-Guided Path Prioritization..."). It walks each candidate state's
+  /// ExecutionTree ancestor chain and scores it higher when an ancestor
+  /// branch's sibling subtree has already produced a terminated ("closed")
+  /// path -- i.e. the state sits on the still-open side of a comparison that
+  /// completing would close. This is a structural simplification of the
+  /// paper's full H-ancestor/secret-aware design: it treats every branch
+  /// site as a candidate "comparison" rather than only secret-dependent
+  /// ones, because that labeling needs ENCIDER's own byte-level information
+  /// flow tracking, which this standalone KLEE checkout does not have.
+  /// Honesty note: this searcher is new, real, and runs end to end on real
+  /// KLEE, but it is a reduced-scope reimplementation, not the paper's full
+  /// RiskSelect with static indicator g(.) -- see klee/RISKSEARCHER_NOTES.md
+  /// in the companion research-code repo for exactly what is and isn't here.
+  class RiskSearcher final : public Searcher {
+    std::vector<ExecutionState *> states;
+    RNG &theRNG;
+    // Nodes (by address) whose subtree has produced >=1 terminated path.
+    std::unordered_set<ExecutionTreeNode *> closedSubtree;
+    double wP;  // weight for each open comparison this state could close
+    double wD;  // weight for depth (secondary tie-breaker, like the paper's wD)
+    double eta; // epsilon: probability of a uniform-random pick instead (like
+                // the paper's random-path mixing share, Eq. 8)
+
+    double score(ExecutionState *es) const;
+    void markClosed(ExecutionState *es);
+
+  public:
+    explicit RiskSearcher(RNG &rng, double wP = 2.0, double wD = 0.1,
+                          double eta = 0.1);
+    ExecutionState &selectState() override;
+    void update(ExecutionState *current,
+                const std::vector<ExecutionState *> &addedStates,
+                const std::vector<ExecutionState *> &removedStates) override;
+    bool empty() override;
+    void printName(llvm::raw_ostream &os) override;
+  };
+
