+//===----------------------------------------------------------------------===//
+// RiskSearcher (SYSREL / Risk-Guided Scheduling Extension)
+//===----------------------------------------------------------------------===//
+
+RiskSearcher::RiskSearcher(double _wP, double _wD, double _wS, double _eta)
+  : wP(_wP), wD(_wD), wS(_wS), eta(_eta) {
+}
+
+RiskSearcher::~RiskSearcher() {
+}
+
+void RiskSearcher::markClosed(ExecutionState *es) {
+  PTreeNode *node = es->ptreeNode;
+  while (node) {
+    if (node->closed)
+      break;
+    node->closed = true;
+    node = node->parent;
+  }
+}
+
+double RiskSearcher::score(ExecutionState *es) const {
+  PTreeNode *node = es->ptreeNode;
+  if (!node)
+    return 0.0;
+  double openComparisons = 0.0;
+  unsigned depth = 0;
+  while (node && node->parent) {
+    PTreeNode *parent = node->parent;
+    PTreeNode *sibling = (parent->left == node) ? parent->right : parent->left;
+    bool siblingClosed = (!sibling) || sibling->closed;
+    if (siblingClosed && !node->closed)
+      openComparisons += 1.0;
+    node = parent;
+    ++depth;
+  }
+  double secretBonus = es->isSecretDescendant() ? wS : 0.0;
+  return wP * openComparisons + wD * static_cast<double>(depth) + secretBonus;
+}
+
+ExecutionState &RiskSearcher::selectState() {
+  assert(!states.empty() && "RiskSearcher::selectState() on empty searcher");
+  if (states.size() > 1 && theRNG.getDoubleL() < eta) {
+    return *states[theRNG.getInt32() % states.size()];
+  }
+  ExecutionState *best = states[0];
+  double bestScore = score(best);
+  for (size_t i = 1; i < states.size(); ++i) {
+    double s = score(states[i]);
+    if (s > bestScore) {
+      bestScore = s;
+      best = states[i];
+    }
+  }
+  return *best;
+}
+
+void RiskSearcher::update(ExecutionState *current,
+                          const std::vector<ExecutionState *> &addedStates,
+                          const std::vector<ExecutionState *> &removedStates) {
+  for (std::vector<ExecutionState *>::const_iterator it = addedStates.begin(),
+                                                     ie = addedStates.end();
+       it != ie; ++it) {
+    states.push_back(*it);
+  }
+
+  for (std::vector<ExecutionState *>::const_iterator it = removedStates.begin(),
+                                                     ie = removedStates.end();
+       it != ie; ++it) {
+    ExecutionState *es = *it;
+    markClosed(es);
+    std::vector<ExecutionState *>::iterator pos =
+        std::find(states.begin(), states.end(), es);
+    if (pos != states.end()) {
+      std::swap(*pos, states.back());
+      states.pop_back();
+    }
+  }
+}
+
+bool RiskSearcher::empty() {
+  return states.empty();
+}
+
+void RiskSearcher::printName(llvm::raw_ostream &os) {
+  os << "RiskSearcher (open-comparison + secret-guided scheduler for ENCIDER)\n";
+}
+
