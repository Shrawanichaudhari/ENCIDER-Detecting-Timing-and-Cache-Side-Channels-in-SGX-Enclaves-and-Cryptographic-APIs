+// ----------------------------------------------------------------------
+// RiskSearcher: real, running, reduced-scope prototype of the paper's
+// open-comparison-guided scheduler. See Searcher.h for the honesty note
+// on what is and isn't reproduced here relative to the full RiskSelect
+// design (no secret-labeling / static indicator g(.) -- those need
+// ENCIDER's own IFT, which this standalone KLEE checkout doesn't have).
+// ----------------------------------------------------------------------
+RiskSearcher::RiskSearcher(RNG &rng, double wP, double wD, double eta)
+    : theRNG(rng), wP(wP), wD(wD), eta(eta) {}
+
+void RiskSearcher::markClosed(ExecutionState *es) {
+  ExecutionTreeNode *node = es->executionTreeNode;
+  while (node) {
+    if (!closedSubtree.insert(node).second)
+      break; // already marked on the way up from an earlier termination
+    node = node->parent;
+  }
+}
+
+double RiskSearcher::score(ExecutionState *es) const {
+  ExecutionTreeNode *node = es->executionTreeNode;
+  if (!node)
+    return 0.0;
+  double openComparisons = 0.0;
+  unsigned depth = 0;
+  while (node && node->parent) {
+    ExecutionTreeNode *parent = node->parent;
+    ExecutionTreeNode *sibling = (parent->left.getPointer() == node)
+                                     ? parent->right.getPointer()
+                                     : parent->left.getPointer();
+    // Open comparison: the sibling side of this branch already has a
+    // terminated path, but this state's own side (so far) does not --
+    // i.e. finishing this path would be the one that closes the pair.
+    if (sibling && closedSubtree.count(sibling) && !closedSubtree.count(node))
+      openComparisons += 1.0;
+    node = parent;
+    ++depth;
+  }
+  return wP * openComparisons + wD * static_cast<double>(depth);
+}
+
+ExecutionState &RiskSearcher::selectState() {
+  assert(!states.empty() && "RiskSearcher::selectState() on empty searcher");
+  if (states.size() > 1 && theRNG.getDoubleL() < eta) {
+    // Random-path-style fallback share (paper Eq. 8): avoid starving
+    // low-score states and keep the searcher from getting stuck if the
+    // structural signal is uninformative for a given program.
+    return *states[theRNG.getInt32() % states.size()];
+  }
+  ExecutionState *best = states[0];
+  double bestScore = score(best);
+  for (size_t i = 1; i < states.size(); ++i) {
+    double s = score(states[i]);
+    if (s > bestScore) {
+      bestScore = s;
+      best = states[i];
+    }
+  }
+  return *best;
+}
+
+void RiskSearcher::update(ExecutionState *current,
+                          const std::vector<ExecutionState *> &addedStates,
+                          const std::vector<ExecutionState *> &removedStates) {
+  for (auto es : addedStates)
+    states.push_back(es);
+
+  for (auto es : removedStates) {
+    markClosed(es); // record: this branch's side just terminated
+    auto it = std::find(states.begin(), states.end(), es);
+    if (it != states.end()) {
+      std::swap(*it, states.back());
+      states.pop_back();
+    }
+  }
+}
+
+bool RiskSearcher::empty() { return states.empty(); }
+
+void RiskSearcher::printName(llvm::raw_ostream &os) {
+  os << "RiskSearcher (real, reduced-scope prototype of paper's "
+        "open-comparison scheduler)\n";
+}
