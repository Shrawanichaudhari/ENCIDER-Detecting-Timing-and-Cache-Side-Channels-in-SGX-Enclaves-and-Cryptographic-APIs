+    std::vector<ExecutionState*> states;
+    double wP;  // weight per open ancestor comparison this state could close
+    double wD;  // weight per tree depth (secondary tie-breaker)
+    double wS;  // weight bonus for secret-dependent branch (isSecretDescendant)
+    double eta; // probability of uniform-random pick instead of argmax (diversity)
+
+    double score(ExecutionState *es) const;
+    void markClosed(ExecutionState *es);
+
+  public:
+    RiskSearcher(double _wP = 2.0, double _wD = 0.1, double _wS = 5.0, double _eta = 0.1);
+    ~RiskSearcher();
+
+    ExecutionState &selectState();
+    void update(ExecutionState *current,
+                const std::vector<ExecutionState *> &addedStates,
+                const std::vector<ExecutionState *> &removedStates);
+    bool empty();
+    void printName(llvm::raw_ostream &os);
+  };
